{
	"appId": "com.moboxd.app",
	"appName": "MoBoxd",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"CapacitorUpdater": {
			"appId": "com.moboxd.app",
			"updateUrl": "https://moboxd-backend.onrender.com/api/updates",
			"autoUpdate": "atBackground",
			"defaultChannel": "production",
			"resetWhenUpdate": true
		}
	},
	"server": {
		"androidScheme": "https",
		"iosScheme": "https",
		"hostname": "localhost"
	}
}
